<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Posts - Post Manager</title>
    <link rel="stylesheet" href="/css/posts.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <nav class="navbar">
        <div class="navbar-container">
            <div class="brand">
                <span>Post Manager</span>
            </div>
            <ul class="nav-links">
                <li><a href="/">Dashboard</a></li>
                <li><a href="/api/posts" class="nav-highlight">My Posts</a></li>
            </ul>
        </div>
    </nav>

    <div class="container">
        <div class="page-header">
            <div class="header-content">
                <div class="welcome" id="welcomeText">Loading...</div>
                <h1>My Saved Posts</h1>
                <p class="header-subtitle">Manage your saved posts collection</p>
            </div>
        </div>

        <div class="card">
            <div class="action-bar">
                <button id="deletePost" class="btn-danger">Delete All Posts</button>
                <button id="logout" class="btn-logout">Logout</button>
            </div>

            <div id="postsContainer" class="posts-container">
                <div class="loading-state">
                    <div class="spinner"></div>
                    <p>Loading your posts...</p>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/posts.js"></script>
</body>
</html>
