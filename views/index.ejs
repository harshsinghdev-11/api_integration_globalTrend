<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JSON Placeholder Viewer</title>
    <link rel="stylesheet" href="/css/index.css">
</head>
<body>

    <nav class="navbar">
  <div class="navbar-container">
    <div class="brand">API Dashboard</div>
    <ul class="nav-links">
      <li><a href="/api/auth/register">Register</a></li>
      <li><a href="/api/auth/login">Login</a></li>
      <li><a href="/api/posts">Saved Posts</a></li>
    </ul>
  </div>
</nav>

<div class="container">
    <header>
        <h1>API UI Dashboard</h1>
        <div class="subtitle">Professional JSON Placeholder Management System</div>
         <a href="/api/posts">
  <button style="padding: 10px 20px; background: #4e4376; color: white; border: none; border-radius: 5px; cursor: pointer; margin-top: 10px;">
    View Saved Posts
  </button>
</a>
    </header>
   

    

    <div class="sections-grid">
        <div class="section">
            <h2>View Data</h2>
            <div class="input-group">
                 <button id="fetchhundredPost">Fetch  100 Posts</button>
                <div class="form-row">
                    <label for="id">Post ID</label>
                    <input placeholder="Enter post ID" type="number" id="id" min="1">
                </div>
                <button id="submitId">Fetch Single Post</button>
                
               
            </div>
            <div class="input-group" style="margin-top: 20px;">
                <div class="form-row">
                    <label for="userId">User ID</label>
                    <input placeholder="Enter user ID" type="number" id="userId" min="1">
                </div>
                <button id="userPost">Fetch User Posts</button>
            </div>
        </div>

        <!-- Filter Section -->
        <div class="section">
            <h2>Filter Cached Posts</h2>
            <div class="input-group">
                <div class="form-row">
                    <label for="filterKeyword">Search Keyword</label>
                    <input type="text" id="filterKeyword" placeholder="Search title or body">
                </div>
                <div class="form-row">
                    <label for="filterUserId">User ID</label>
                    <input type="number" id="filterUserId" placeholder="Filter by user ID" min="1">
                </div>
                <div class="form-row">
                    <label for="filterMinLength">Min Body Length</label>
                    <input type="number" id="filterMinLength" placeholder="Minimum length" min="0">
                </div>
                <div class="form-row">
                    <label for="filterMaxLength">Max Body Length</label>
                    <input type="number" id="filterMaxLength" placeholder="Maximum length" min="0">
                </div>
                <button id="applyFilter">Apply Filter</button>
                <button id="clearFilter" style="background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);">Clear Filter</button>
            </div>
        </div>

        <!-- Create Post Section -->
        <div class="section">
            <h2>Create Post</h2>
            <form id="createForm">
                <div class="form-row">
                    <label for="title">Title</label>
                    <input type="text" id="title" placeholder="Enter post title" required>
                </div>
                <div class="form-row">
                    <label for="body">Body</label>
                    <textarea id="body" placeholder="Enter post content" required></textarea>
                </div>
                <div class="form-row">
                    <label for="createuserId">User ID</label>
                    <input type="number" id="createuserId" placeholder="Enter user ID" min="1" required>
                </div>
                <button type="submit">Create New Post</button>
            </form>
        </div>

        <!-- Update Post Section -->
        <div class="section">
            <h2>Update Post</h2>
            <form id="updateForm">
                <div class="form-row">
                    <label for="UpdateId">Post ID</label>
                    <input type="number" id="UpdateId" placeholder="Post ID to update" min="1" required>
                </div>
                <div class="form-row">
                    <label for="updateTitle">New Title</label>
                    <input type="text" id="updateTitle" placeholder="Enter new title" required>
                </div>
                <div class="form-row">
                    <label for="updateBody">New Body</label>
                    <textarea id="updateBody" placeholder="Enter new content" required></textarea>
                </div>
                <div class="form-row">
                    <label for="updateUserId">User ID</label>
                    <input type="number" id="updateUserId" placeholder="Enter user ID" min="1" required>
                </div>
                <button type="submit">Update Post</button>
            </form>
        </div>
    </div>

    <div id="messageBox"></div>
    <div class="center-btn">
  <button id="saveAllPosts">Save All Displayed Posts</button>
</div>

    <div class="results-section" id="tableBox"></div>
    
</div>

<script src="/js/index.js"></script>

</body>
</html>